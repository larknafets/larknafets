# Blocks live in blocks/<name>.md. profile, career, skills and contact are hand-written,
# principles and stats are generated by .github/update-blocks.sh, status by .github/build.sh.

# Commits whose subjects become the principles block, in this order.
principles = c7b3500 fadad2b 69186dd

# Reference only: the commit "I was born at 337 ppm." is not rendered anywhere.
born = 0bcfced

# Status: employed (not looking), open (employed, open to new things), unemployed or away (vacation, offline).
status = open

# Profile block: only the Role line and the age in the Uptime line are generated from these.
role  = Senior IT Consultant
birth = 1979-08

# Maximum line width of the outputs: longer lines in code blocks wrap at word borders, indented under the value.
width = 60

# Outputs: file = blocks in order. The site README is pulled by the private website.
README.md      = status profile principles stats contact
site/README.md = status profile principles career skills contact stats
